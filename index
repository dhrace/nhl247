<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">\</script>

<script>

const arenas = {
  MTL:[45.496,-73.5693],
  TOR:[43.6435,-79.3791],
  OTT:[45.2969,-75.9272],
  EDM:[53.5461,-113.497],
  CGY:[51.0374,-114.05],
  VAN:[49.2775,-123.108],
  WPG:[49.8926,-97.1439],
  SEA:[47.622,-122.354],
  LAK:[34.043,-118.2673],
  ANA:[33.8078,-117.8767],
  VGK:[36.1028,-115.178],
  COL:[39.7487,-105.0077],
  DAL:[32.7905,-96.8103],
  CHI:[41.8807,-87.6742],
  MIN:[44.9448,-93.101],
  STL:[38.6268,-90.2026],
  NSH:[36.1591,-86.7785],
  DET:[42.3411,-83.055],
  CBJ:[39.969,-83.0063],
  PIT:[40.439,-79.9894],
  BUF:[42.875,-78.8766],
  BOS:[42.3662,-71.0621],
  NYR:[40.7505,-73.9934],
  NYI:[40.7229,-73.5905],
  NJD:[40.7336,-74.171],
  PHI:[39.9012,-75.1719],
  WSH:[38.8981,-77.0209],
  CAR:[35.8033,-78.7218],
  TBL:[27.9427,-82.4518],
  FLA:[26.1585,-80.3256],
  SJS:[37.3328,-121.9011]
};

let markers = [];
let games = [];
let filterMode = 'ALL';

const map = L.map('map', {
  zoomControl: true
}).setView([45, -97], 4);

L.tileLayer(
  'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
  {
    attribution: '© OpenStreetMap',
    maxZoom: 18
  }
).addTo(map);

function clearMarkers() {
  markers.forEach(marker => map.removeLayer(marker));
  markers = [];
}

function getStatusText(game) {

  if (game.gameState === 'LIVE') {

    const period =
      game.periodDescriptor?.number || '?';

    const clock =
      game.clock?.timeRemaining || '';

    return `${period}e période ${clock}`;
  }

  if (game.gameState === 'FUT') {

    return new Date(
      game.startTimeUTC
    ).toLocaleTimeString(
      'fr-CA',
      {
        hour:'2-digit',
        minute:'2-digit'
      }
    );
  }

  if (
    game.gameState === 'FINAL' ||
    game.gameState === 'OFF'
  ) {
    return 'FINAL';
  }

  return game.gameState || '';
}

function getBadgeClass(state) {

  if(state === 'LIVE')
    return 'badge live';

  if(
    state === 'FINAL' ||
    state === 'OFF'
  )
    return 'badge final';

  return 'badge';
}

function renderList() {

  const search =
    document
    .getElementById('search')
    .value
    .toUpperCase();

  let html = '';

  games
  .filter(game => {

    if(filterMode === 'ALL')
      return true;

    if(
      filterMode === 'FINAL' &&
      game.gameState === 'OFF'
    )
      return true;

    return game.gameState === filterMode;
  })

  .filter(game => {

    const text =
      `${game.awayTeam.abbrev} ${game.homeTeam.abbrev}`;

    return text.includes(search);
  })

  .forEach(game => {

    html += `
      <div class="game">

        <div>
          <span class="${getBadgeClass(game.gameState)}">
            ${game.gameState}
          </span>
        </div>

        <b>
          ${game.awayTeam.abbrev}
          @
          ${game.homeTeam.abbrev}
        </b>

        <div class="score">
          ${game.awayTeam.score || 0}
          -
          ${game.homeTeam.score || 0}
        </div>

        <div>
          ${getStatusText(game)}
        </div>

      </div>
    `;
  });

  document.getElementById('games').innerHTML =
    html || 'Aucun match';
}

async function loadGames() {

  document.getElementById('status').textContent =
    'Chargement NHL...';

  try {

    const response =
      await fetch(
        'https://api-web.nhle.com/v1/scoreboard/now'
      );

    if(!response.ok) {

      throw new Error(
        'Réponse NHL: ' +
        response.status
      );
    }

    const data =
      await response.json();

    games = [];

    (data.gamesByDate || [])
    .forEach(day => {

      (day.games || [])
      .forEach(game => {

        games.push(game);

      });

    });

    clearMarkers();

    games.forEach(game => {

      const home =
        game.homeTeam.abbrev;

      if(!arenas[home])
        return;

      const status =
        getStatusText(game);

      const marker =
        L.marker(
          arenas[home]
        ).addTo(map);

      marker.bindPopup(`
        <div class="markerCard">

          <h3>
            ${game.awayTeam.abbrev}
            @
            ${game.homeTeam.abbrev}
          </h3>

          <div class="score">
            ${game.awayTeam.score || 0}
            -
            ${game.homeTeam.score || 0}
          </div>

          <div>
            ${status}
          </div>

        </div>
      `);

      markers.push(marker);

    });

    renderList();

    document.getElementById('status').textContent =
      'MAJ ' +
      new Date().toLocaleTimeString(
        'fr-CA'
      );

    document.getElementById('debug').textContent =
`Matchs chargés: ${games.length}
API NHL: OK
Carte: OK
Dernière MAJ: ${new Date().toLocaleString('fr-CA')}`;

  }

  catch(error) {

    console.error(error);

    document.getElementById('status').textContent =
      'Erreur';

    document.getElementById('games').innerHTML =
      '<div class="game">Erreur lors du chargement de l’API NHL.</div>';

    document.getElementById('debug').textContent =
      error.message;
  }
}

document
.getElementById('search')
.addEventListener(
  'input',
  renderList
);

loadGames();

setInterval(
  loadGames,
  30000
);

</script>
